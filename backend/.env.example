# Copy to .env and fill in from your Supabase project's Settings -> API page.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# No JWT secret needed -- auth tokens are verified against Supabase's own
# JWKS endpoint (derived from SUPABASE_URL above), not a shared secret. See
# app/deps.py.

# Comma-separated. Include the Vercel deployment URL in production.
ALLOWED_ORIGINS=http://localhost:5173

# Shared secret for the scheduled waiver-alert scan (POST /internal/waiver-
# scan, called hourly by .github/workflows/waiver-scan.yml via GitHub
# Actions, not Vercel Cron -- see that workflow's comment for why). Unset
# locally is fine, that endpoint just 401s; must be set as a Vercel
# Production env var (and mirrored as the CRON_SECRET GitHub Actions repo
# secret) for the real scan to run.
CRON_SECRET=
