# Copy to .env and fill in from your Supabase project's Settings -> API page.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# No JWT secret needed -- auth tokens are verified against Supabase's own
# JWKS endpoint (derived from SUPABASE_URL above), not a shared secret. See
# app/deps.py.

# Comma-separated. Include the Vercel deployment URL in production.
ALLOWED_ORIGINS=http://localhost:5173
