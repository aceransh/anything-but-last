{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "season-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "season-backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && .venv/bin/uvicorn app.main:app --reload --reload-dir app --port 8001"],
      "port": 8001
    }
  ]
}
